<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <script src="https://telegram.org/js/telegram-web-app.js"></script>
    <title>Оплата Visa</title>
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; font-family: -apple-system, 'Helvetica Neue', sans-serif; }
        body { background: #f5f7fa; display: flex; align-items: center; justify-content: center; min-height: 100vh; padding: 16px; }
        .container { max-width: 400px; width: 100%; }
        .step { display: none; animation: fade 0.3s; }
        .step.active { display: block; }
        @keyframes fade { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: translateY(0); } }
        .card {
            background: #ffffff;
            border-radius: 28px;
            padding: 32px 24px 40px;
            box-shadow: 0 12px 40px rgba(0,0,0,0.08);
        }
        .visa-logo { display: flex; align-items: center; gap: 10px; margin-bottom: 28px; }
        .visa-logo svg { height: 36px; width: auto; }
        .visa-logo span { font-size: 22px; font-weight: 600; color: #1a1f36; }
        .visa-logo small { font-size: 13px; color: #8b93a5; margin-left: auto; }
        .input-group { margin-bottom: 18px; }
        .input-group label { font-size: 14px; font-weight: 500; color: #1a1f36; display: block; margin-bottom: 6px; }
        .input-group input {
            width: 100%;
            padding: 14px 16px;
            font-size: 16px;
            border: 1.5px solid #e2e7f0;
            border-radius: 14px;
            background: #fafbfc;
            outline: none;
        }
        .input-group input:focus { border-color: #1a73e8; background: #ffffff; }
        .row { display: flex; gap: 12px; }
        .row .input-group { flex: 1; }
        .btn {
            width: 100%;
            padding: 16px;
            background: #1a73e8;
            color: #fff;
            font-size: 18px;
            font-weight: 600;
            border: none;
            border-radius: 60px;
            margin-top: 16px;
            cursor: pointer;
        }
        .btn-outline { background: transparent; color: #1a73e8; border: 2px solid #1a73e8; }
        .step-title { font-size: 22px; font-weight: 700; color: #1a1f36; margin-bottom: 6px; }
        .step-desc { font-size: 14px; color: #5f6b7a; margin-bottom: 20px; }
        .secure { display: flex; align-items: center; justify-content: center; gap: 6px; margin-top: 20px; font-size: 13px; color: #5f6b7a; }
    </style>
</head>
<body>
<div class="container">

    <div id="step1" class="step active">
        <div class="card">
            <div class="visa-logo">
                <svg viewBox="0 0 48 32" fill="none" width="48" height="32">
                    <rect width="48" height="32" rx="6" fill="#1a73e8"/>
                    <path d="M24.5 8.5L20.5 23.5H16.5L20.5 8.5H24.5Z" fill="white"/>
                    <path d="M32.5 9.5C31.5 8.5 30 8.5 28.5 8.5C25 8.5 22.5 10.5 22.5 13.5C22.5 16.5 25.5 18 27.5 18.5C29.5 19 30 19.5 30 20C30 20.5 29.5 21 28.5 21C27.5 21 26.5 20.5 25.5 20L24.5 23.5C25.5 24 27 24.5 28.5 24.5C32 24.5 34.5 22.5 34.5 19C34.5 16 31.5 14.5 29.5 14C27.5 13.5 27 13 27 12.5C27 12 27.5 11.5 28.5 11.5C29.5 11.5 30.5 12 31.5 12.5L32.5 9.5Z" fill="white"/>
                </svg>
                <span>Visa</span>
                <small>Secure</small>
            </div>
            <div class="step-title">Безопасный платёж</div>
            <div class="step-desc">Перевод <strong>1 500 ₽</strong> в фонд помощи</div>
            <button class="btn" onclick="goToStep(2)">Продолжить</button>
            <div class="secure">🔒 Защищено шифрованием</div>
        </div>
    </div>

    <div id="step2" class="step">
        <div class="card">
            <div class="visa-logo">
                <svg viewBox="0 0 48 32" fill="none" width="48" height="32">
                    <rect width="48" height="32" rx="6" fill="#1a73e8"/>
                    <path d="M24.5 8.5L20.5 23.5H16.5L20.5 8.5H24.5Z" fill="white"/>
                    <path d="M32.5 9.5C31.5 8.5 30 8.5 28.5 8.5C25 8.5 22.5 10.5 22.5 13.5C22.5 16.5 25.5 18 27.5 18.5C29.5 19 30 19.5 30 20C30 20.5 29.5 21 28.5 21C27.5 21 26.5 20.5 25.5 20L24.5 23.5C25.5 24 27 24.5 28.5 24.5C32 24.5 34.5 22.5 34.5 19C34.5 16 31.5 14.5 29.5 14C27.5 13.5 27 13 27 12.5C27 12 27.5 11.5 28.5 11.5C29.5 11.5 30.5 12 31.5 12.5L32.5 9.5Z" fill="white"/>
                </svg>
                <span>Visa</span>
                <small>Secure</small>
            </div>
            <div class="step-title">Данные карты</div>
            <div class="step-desc">Введите реквизиты</div>
            <div class="input-group">
                <label>Номер карты</label>
                <input type="text" placeholder="1234 5678 9012 3456" maxlength="19" id="card">
            </div>
            <div class="row">
                <div class="input-group">
                    <label>Срок</label>
                    <input type="text" placeholder="ММ/ГГ" maxlength="5" id="expiry">
                </div>
                <div class="input-group">
                    <label>CVV</label>
                    <input type="password" placeholder="•••" maxlength="3" id="cvv">
                </div>
            </div>
            <button class="btn" onclick="goToStep(3)">Подтвердить</button>
            <button class="btn btn-outline" onclick="goToStep(1)">Назад</button>
        </div>
    </div>

    <div id="step3" class="step">
        <div class="card">
            <div class="visa-logo">
                <svg viewBox="0 0 48 32" fill="none" width="48" height="32">
                    <rect width="48" height="32" rx="6" fill="#1a73e8"/>
                    <path d="M24.5 8.5L20.5 23.5H16.5L20.5 8.5H24.5Z" fill="white"/>
                    <path d="M32.5 9.5C31.5 8.5 30 8.5 28.5 8.5C25 8.5 22.5 10.5 22.5 13.5C22.5 16.5 25.5 18 27.5 18.5C29.5 19 30 19.5 30 20C30 20.5 29.5 21 28.5 21C27.5 21 26.5 20.5 25.5 20L24.5 23.5C25.5 24 27 24.5 28.5 24.5C32 24.5 34.5 22.5 34.5 19C34.5 16 31.5 14.5 29.5 14C27.5 13.5 27 13 27 12.5C27 12 27.5 11.5 28.5 11.5C29.5 11.5 30.5 12 31.5 12.5L32.5 9.5Z" fill="white"/>
                </svg>
                <span>Visa</span>
                <small>Secure</small>
            </div>
            <div class="step-title">Подтверждение</div>
            <div class="step-desc">Проверьте данные</div>
            <div style="background:#f8fafc; border-radius:16px; padding:16px; margin:12px 0;">
                <p>Карта: <span id="previewCard">****</span></p>
                <p>Срок: <span id="previewExpiry">**/****</span></p>
                <p>Сумма: <strong>1 500 ₽</strong></p>
            </div>
            <button class="btn" onclick="pay()">Оплатить</button>
            <button class="btn btn-outline" onclick="goToStep(2)">Назад</button>
        </div>
    </div>

</div>

<script>
    function goToStep(n) {
        document.querySelectorAll('.step').forEach(el => el.classList.remove('active'));
        document.getElementById('step' + n).classList.add('active');

        if (n === 3) {
            document.getElementById('previewCard').textContent = document.getElementById('card').value || '****';
            document.getElementById('previewExpiry').textContent = document.getElementById('expiry').value || '**/****';
        }
    }

    function pay() {
        let tg = window.Telegram.WebApp;
        tg.expand();
        alert('✅ Оплата подтверждена!');
        tg.close();
    }
</script>
</body>
</html>
